        "kitchen": {
            "title_de": "Küche",
            "title_en": "Cuisine",
            "text_de": "Massimo Desortes leitet die Küche seit 2005. Im Vordergrund steht eine traditionelle, zuverlässige und handwerklich feine italienische Kochkunst.",
            "text_en": "Massimo Desortes has been leading the kitchen since 2005. The focus is on traditional, reliable and artisanal Italian culinary art."
